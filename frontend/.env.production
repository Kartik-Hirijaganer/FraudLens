# Non-secret production build values. The browser never talks to the gateway FQDN directly: the
# Vercel rewrite in vercel.json proxies /api/* to ${AZURE_API_ORIGIN}, so every API call is
# same-origin against https://fraud-lens-amber.vercel.app. An empty base URL is what makes the
# client emit relative paths; setting a real origin here would reintroduce the CORS dependency and
# a second public hostname that changes whenever the Container App is recreated.
VITE_API_BASE_URL=

# Public synthetic persona picker. Pinned HERE, not in the deploy workflow, because a
# step-level env var only reaches the CLI build: this file is read by Vite from the project
# root directory under every publisher, so the picker cannot silently vanish from a build
# nobody dispatched. It is a build-time GATE ONLY -- it never enables VITE_AUTH_DEV_BYPASS,
# and every persona still signs in through Supabase and /api/v1/me.
VITE_DEMO_AUTH_ENABLED=true
