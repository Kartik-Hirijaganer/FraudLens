# Remote-state backend (azurerm) for the dev environment.
#
# DO NOT rename to backend.tf until the Terraform state storage account exists
# (see ../../README.md → "State backend bootstrap"). While this is a .template,
# Terraform ignores it, so `terraform init -backend=false && terraform validate`
# works with no backend. At provisioning: copy to backend.tf, then `terraform init`.

terraform {
  backend "azurerm" {
    resource_group_name  = "fraudlens-tfstate-rg"
    storage_account_name = "fraudlenstfstate"
    container_name       = "tfstate"
    key                  = "dev.terraform.tfstate"
    use_oidc             = true
  }
}
