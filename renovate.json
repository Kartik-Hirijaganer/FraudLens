{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "security:openssf-scorecard"
  ],
  "timezone": "America/New_York",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group minor + patch updates and automerge ONLY when fully green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Major updates are isolated and always require human review.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    }
  ],
  "pep621": { "enabled": true },
  "npm": { "enabled": true },
  "terraform": { "enabled": true },
  "github-actions": { "enabled": true },
  "docker": { "enabled": true }
}
