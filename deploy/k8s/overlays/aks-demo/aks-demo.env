FRAUDLENS_ENVIRONMENT=prod
FRAUDLENS_INFISICAL_SECRETS_DELIVERY=externally_injected
FRAUDLENS_INFISICAL_REQUIRED_ENV_KEYS=["DATABASE_URL","SUPABASE_SERVICE_ROLE_KEY"]
FRAUDLENS_LLM_MODE=live
FRAUDLENS_QUEUE_BACKEND=local
FRAUDLENS_RUN_EXECUTION_MODE=worker
FRAUDLENS_RUN_LEASE_SECONDS=30
FRAUDLENS_RUN_HEARTBEAT_SECONDS=5
FRAUDLENS_RUN_RETRY_BACKOFF_SECONDS=1
FRAUDLENS_STORAGE_BACKEND=local
FRAUDLENS_PORTFOLIO_DEMO_ENABLED=true
