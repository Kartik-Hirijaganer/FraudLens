FRAUDLENS_ENVIRONMENT=dev
FRAUDLENS_AUTH_DEV_BYPASS=true
FRAUDLENS_LLM_MODE=mock
FRAUDLENS_MULTI_AGENT_SAR_ENABLED=true
FRAUDLENS_QUEUE_BACKEND=local
FRAUDLENS_STORAGE_BACKEND=local
FRAUDLENS_INFISICAL_SECRETS_DELIVERY=unconfigured
FRAUDLENS_RUN_LEASE_SECONDS=30
FRAUDLENS_RUN_HEARTBEAT_SECONDS=5
FRAUDLENS_RUN_DEADLINE_SECONDS=900
FRAUDLENS_RUN_RETRY_BACKOFF_SECONDS=1
