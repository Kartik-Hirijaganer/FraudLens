{
  "mcpServers": {
    "code-review-graph": {
      "command": "bash",
      "args": ["scripts/run-code-review-graph-mcp.sh"]
    },
    "drawio": {
      "command": "npx",
      "args": ["-y", "@drawio/mcp@1.10.0"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
