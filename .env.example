# FraudLens — LOCAL, NON-SECRET config template. Copy to `.env` for `make local-demo`.
#
# Golden Rule 2: real secrets (provider API keys, the production DATABASE_URL, JWT
# signing keys) come from Infisical at runtime and NEVER live here. Everything below is
# non-secret local docker-compose convenience. `.env` is gitignored; `.env.example` is
# committed as documentation. The demo also works with NO `.env` (these are the defaults).

# --- Local Postgres (docker-compose.local.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=fraudlens
POSTGRES_DB=fraudlens

# Async SQLAlchemy URL the backend reads. For local dev it is derived from the POSTGRES_*
# values above, e.g.
#   postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Set it explicitly only to point the backend at a different (non-local) database.
# DATABASE_URL=

# --- Service ports ---
# Leave BACKEND_PORT / FRONTEND_PORT unset to let scripts/local_demo.py choose free fallbacks when
# the common defaults are already owned by another local project.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Boot config overrides (non-secret defaults live in config/*.yaml) ---
FRAUDLENS_ENVIRONMENT=dev
FRAUDLENS_STORAGE_BACKEND=local
FRAUDLENS_QUEUE_BACKEND=local
FRAUDLENS_LOCAL_JOB_EXECUTE_ON_SUBMIT=true
FRAUDLENS_LLM_MODE=mock
